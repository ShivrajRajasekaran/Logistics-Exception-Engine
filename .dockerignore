# Keep the build context small. Without this, `docker build` uploads the venv
# (several GB of torch) and the entire image dataset before the first layer runs.

venv/
.venv/
__pycache__/
*.pyc
*.pyo

# Datasets and training artifacts are not needed to serve the model.
dataset/_raw/
dataset/train/
dataset/val/
dataset/test/
runs/

# The serving checkpoint is baked in so the image is self-sufficient on a
# host with no docker-compose (Hugging Face Spaces, Render, a bare VM).
# docker-compose still bind-mounts weights/ read-only over the same path, so
# swapping a checkpoint locally never needs a rebuild. Other checkpoints
# (best_v3.pt, experiment weights) are excluded to keep the image small.
weights/*
!weights/best.pt

.env
.git/
.gitignore
tests/
*.md
*.pdf
