# Copy to .env and fill in. .env is gitignored.

# --- Dataset acquisition (scripts/prepare_dataset.py only) ---
# Free key from https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=

# --- Part B reasoning layer ---
# Optional. With no key the /reason endpoint still works end to end and returns
# a clearly labelled deterministic summary instead of LLM prose, so the routing
# and guardrail logic can be reviewed without credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Detection runtime ---
WEIGHTS_PATH=weights/best.pt
CONFIDENCE_THRESHOLD=0.25

# --- Guardrail ---
# Peak confidence a critical class must reach before the LLM is consulted.
GUARDRAIL_THRESHOLD=0.65
# When true, an image with zero defect detections also halts as
# INSUFFICIENT_INFORMATION. Default false: a confidently localized parcel with
# no defect is a genuine CLEAR result.
STRICT_ZERO_DETECTION_HALT=false

# --- Serving ---
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=20971520
