venv/
.venv/
__pycache__/
.agents/
*.pyc
.pytest_cache/
.env
runs/

# Generated by scripts/prepare_dataset.py. The split report IS committed, so
# reviewers can see the real class distribution without downloading the data.
dataset/_raw/
dataset/train/
dataset/val/
dataset/test/
!dataset/split_report.json

*.egg-info/

# Base checkpoints auto-downloaded by Ultralytics on first run.
# rtdetr-l.pt is the RT-DETR backbone; yolo11n.pt is pulled by the AMP check.
# Both re-download automatically, so neither belongs in the repo.
rtdetr-l.pt
yolo11n.pt

# RAP's own assignment brief does not belong in a public repo.
*.pdf

# Superseded and duplicate checkpoints. The SHIPPED model is weights/best.pt and
# it is committed. These are local-only copies kept for comparison:
#   weights/best_v3.pt          byte-identical to weights/best.pt
#   experiments/*/weights_*.pt  the v1 and rejected-v2 checkpoints
# Their manifests and metrics JSON ARE committed, so every number in MEMO.md
# stays traceable without carrying 127 MB of superseded binaries.
weights/best_v3.pt
experiments/**/weights_*.pt
